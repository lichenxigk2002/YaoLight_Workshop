# 数据库（Docker 中由 docker-compose 覆盖为 postgres/redis 服务名）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=workflow_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 服务
SERVER_PORT=8080
SERVER_MODE=release
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_HOURS=24

# 管理后台初始化管理员
# release 环境建议显式配置；debug 环境未配置时会自动创建 admin / admin123456
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# 生产环境：前端访问地址（用于 CORS 与 OAuth 回调，如 http://你的域名 或 http://服务器IP）
FRONTEND_URL=http://localhost

# 上传目录（容器内一般为 /app/uploads）
UPLOAD_PATH=./uploads

# 可选：AI 预设 API Key（不配置则需用户自行填写）
# DEEPSEEK_API_KEY=
# DOUBAO_API_KEY=
# QWEN_API_KEY=
# ZHIPUAI_API_KEY=
# OPENROUTER_API_KEY=
# SPARK_API_PASSWORD=
# HUNYUAN_API_KEY=

# 可选：腾讯云 COS、OAuth、支付宝等，见 infrastructure/config/config.go
