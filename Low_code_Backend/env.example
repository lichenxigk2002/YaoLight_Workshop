# 后端环境变量配置示例
# 复制此文件为 .env 并填写实际的配置值

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=yaolight_workshop_db

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# 服务器配置
SERVER_PORT=8080
SERVER_MODE=debug  # debug 或 release

# 腾讯云邮件服务配置
TENCENT_CLOUD_MAIL_HOST=gz-smtp.qcloudmail.com
TENCENT_CLOUD_MAIL_PORT=465
TENCENT_CLOUD_MAIL_USERNAME=your_email@example.com
TENCENT_CLOUD_MAIL_PASSWORD=your_smtp_password

# Redis 配置（推荐使用，未配置时自动降级到内存缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

