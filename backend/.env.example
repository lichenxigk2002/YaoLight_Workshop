# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=workflow_db
DB_SSLMODE=disable

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_HOURS=24

# Server
SERVER_PORT=8080
SERVER_MODE=debug

# Frontend URL
# Used by invite links, OAuth callbacks, payment return URLs, and CORS checks.
FRONTEND_URL=http://localhost:3000

# Optional admin bootstrap
# In debug mode, if these are left empty, the system may auto-create a default admin.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Mail
TENCENT_CLOUD_MAIL_HOST=gz-smtp.qcloudmail.com
TENCENT_CLOUD_MAIL_PORT=465
TENCENT_CLOUD_MAIL_USERNAME=your_email@example.com
TENCENT_CLOUD_MAIL_PASSWORD=your_smtp_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Upload path
UPLOAD_PATH=./uploads

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key

# Gemini model config
GEMINI_MAX_TOKENS=65536
GEMINI_CHAT_MODEL=google/gemini-3-pro-preview
GEMINI_BASE_URL=https://openrouter.ai/api/v1
GEMINI_STORYBOARD_MAX_TOKENS=65536

# OpenAI model config
OPENAI_CHAT_MODEL=openai/gpt-5.4
OPENAI_MAX_CONTEXT_CHARS=400000
OPENAI_MAX_OUTPUT_TOKENS=128000
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# AI provider keys
DEEPSEEK_API_KEY=your_deepseek_api_key
DOUBAO_API_KEY=your_doubao_api_key
QWEN_API_KEY=your_qwen_api_key
ZHIPUAI_API_KEY=your_zhipuai_api_key
TOKENHUB_API_KEY=your_tokenhub_api_key
SPARK_API_PASSWORD=your_spark_api_password

# AI request timeout (seconds)
AI_REQUEST_TIMEOUT_SECONDS=180

# Optional outbound proxies for AI requests.
# Priority: *_PROXY_URL > OPENROUTER_PROXY_URL > AI_HTTP_PROXY_URL
# Example: socks5://127.0.0.1:7890 or http://127.0.0.1:7890
AI_HTTP_PROXY_URL=
OPENROUTER_PROXY_URL=
GPT_PROXY_URL=
CLAUDE_PROXY_URL=
GEMINI_PROXY_URL=
GROK_PROXY_URL=

# IP geolocation
# The default uses ip-api.com. Override if you want to use your own service or proxy.
IP_GEO_API_BASE_URL=http://ip-api.com/json
IP_GEO_PROXY_URL=

# Alipay
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PID=your_alipay_pid
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_CHARSET=utf-8
ALIPAY_FORMAT=JSON

# Use full PEM content with literal \n if stored in one line.
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nyour_public_key_here\n-----END PUBLIC KEY-----"

# Notify URL should point to the backend API route.
ALIPAY_NOTIFY_URL=http://localhost:8080/api/payment/alipay/notify

# Return URL usually points back to the frontend recharge page.
ALIPAY_RETURN_URL=http://localhost:3000/settings/recharge

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Tencent COS
# If disabled or left incomplete, uploads may fall back to local storage.
COS_ENABLED=false
COS_BUCKET=your_cos_bucket
COS_REGION=ap-guangzhou
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_PUBLIC_BASE_URL=https://your-bucket.cos.ap-guangzhou.myqcloud.com

# GitHub Actions / CI
GITHUB_OWNER=your_github_owner
