# 后端环境变量配置示例
# 复制此文件为 .env 并填写实际的配置值

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=yaolight_workshop_db

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# 服务器配置
SERVER_PORT=8080
SERVER_MODE=debug  # debug 或 release

# 腾讯云邮件服务配置
TENCENT_CLOUD_MAIL_HOST=gz-smtp.qcloudmail.com
TENCENT_CLOUD_MAIL_PORT=465
TENCENT_CLOUD_MAIL_USERNAME=your_email@example.com
TENCENT_CLOUD_MAIL_PASSWORD=your_smtp_password

# Redis 配置（推荐使用，未配置时自动降级到内存缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI预设模型配置（系统级别的共享配置，所有用户可以使用）
# 如果配置了，用户可以在节点中选择"系统预设模型"
# 如果未配置，用户需要自己配置API Key并保存到数据库
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DOUBAO_API_KEY=your_doubao_api_key_here
QWEN_API_KEY=your_qianwen_api_key_here
ZHIPUAI_API_KEY=your_zhipuai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
SPARK_API_PASSWORD=your_spark_apipassword_here
TOKENHUB_API_KEY=your_tokenhub_api_key_here
AI_REQUEST_TIMEOUT_SECONDS=90

# Google OAuth 登录（可选）
# 在 Google Cloud Console 创建 OAuth 2.0 客户端，已获授权的重定向 URI 填：http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth 登录（可选）
# 在 GitHub Developer Settings → OAuth Apps 创建应用，Authorization callback URL 填：http://localhost:8080/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OAuth 登录成功后重定向的前端地址（与前端运行地址一致）
FRONTEND_URL=http://localhost:3000

# 支付宝支付配置（沙箱环境）
# 详细配置说明请参考：ALIPAY_ENV_CONFIG.md
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PID=your_alipay_pid
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_CHARSET=utf-8
ALIPAY_FORMAT=JSON
# 应用私钥（完整格式，包含 -----BEGIN PRIVATE KEY----- 和 -----END PRIVATE KEY-----）
ALIPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n你的私钥内容\n-----END PRIVATE KEY-----
# 支付宝公钥（完整格式，包含 -----BEGIN PUBLIC KEY----- 和 -----END PUBLIC KEY-----）
ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n支付宝公钥内容\n-----END PUBLIC KEY-----
# 异步通知地址（需要使用内网穿透工具获取公网地址）
ALIPAY_NOTIFY_URL=https://your-tunnel-url/api/payment/alipay/notify
# 同步跳转地址
ALIPAY_RETURN_URL=https://your-tunnel-url/payment/callback
