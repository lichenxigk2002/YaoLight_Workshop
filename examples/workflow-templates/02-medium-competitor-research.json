    { "id": "e5", "source": "clean-a", "target": "ai-a" },
    { "id": "e6", "source": "clean-b", "target": "ai-b" },
    { "id": "e7", "source": "ai-a", "target": "merge-1", "targetHandle": "input-0" },
    { "id": "e8", "source": "ai-b", "target": "merge-1", "targetHandle": "input-1" },
    { "id": "e9", "source": "merge-1", "target": "ai-final" },
    { "id": "e10", "source": "ai-final", "target": "output-md" },
    { "id": "e11", "source": "ai-final", "target": "output-json" },
    { "id": "e12", "source": "output-md", "target": "end-1" },
    { "id": "e13", "source": "output-json", "target": "end-1" }
